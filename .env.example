# Local development. Production values are described in docs/investscan-standalone.md.
ENVIRONMENT=development
PROJECT_NAME=ИнвестСкан
DATABASE_URL=sqlite:///./investscan.db
# Generate with: python -c 'import secrets; print(secrets.token_urlsafe(48))'
SECRET_KEY=replace-with-a-random-secret-at-least-40-characters
APP_URL=http://localhost:5173
SHTAB_URL=https://shtab.ugsdom.ru/#platform
CORS_ORIGINS=http://localhost:5173
SESSION_MINUTES=60
# Local-only opt-in. Production compose always forces false.
INVESTSCAN_DEV_AUTH=false

# Shared identity provider used by both Shtab and InvestScan.
# Issuer must match exactly, with HTTPS in production.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_ROLES_CLAIM=investscan_roles

# Dedicated PostgreSQL password. Use a long random hex string (URL-safe).
POSTGRES_PASSWORD=
INVESTSCAN_PORT=8093

# Legacy adapters remain disconnected; not used by the new app.
AVITO_CLIENT_ID=
AVITO_CLIENT_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
HERMES_API_URL=
HERMES_API_KEY=

# Initial HQ-compatible owner-only SSO. Copy the verified subject for THIS client
# from the identity provider during server setup, never infer it from an email.
OIDC_OWNER_SUBJECT=
OIDC_REQUIRED_AMR=mfa pwd otp

# Full deployed commit; set during release, never use main/latest as proof.
INVESTSCAN_RELEASE_SHA=unverified
