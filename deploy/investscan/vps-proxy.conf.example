# Add to the EXISTING TLS-enabled virtual host for invest.ugsdom.ru.
# DNS and a certificate must already point to the intended VPS.
# Keep the current certificate directives managed by your reverse proxy.
location / {
    proxy_pass http://127.0.0.1:8093;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
}
# Auth callbacks must not be logged with their query parameters at any proxy layer.
location /api/v1/investscan/auth/ {
    access_log off;
    proxy_pass http://127.0.0.1:8093;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
}
