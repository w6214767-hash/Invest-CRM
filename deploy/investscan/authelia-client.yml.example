# Merge this client into the EXISTING provider config; do not replace it.
# Render secrets on the server and validate with the installed Authelia version.
# Reuse HQ owner_only policy: deny by default, user:vladimir only.
# The module also requires exact OIDC_OWNER_SUBJECT and the configured AMR mode.
client_id: investscan
client_name: Юржилсервис ИнвестСкан
client_secret: REPLACE_WITH_AUTHELIA_HASH_OF_SEPARATE_CLIENT_SECRET
public: false
authorization_policy: owner_only
require_pkce: true
pkce_challenge_method: S256
redirect_uris:
  - https://invest.ugsdom.ru/api/v1/investscan/auth/callback
scopes:
  - openid
  - profile
response_types:
  - code
grant_types:
  - authorization_code
token_endpoint_auth_method: client_secret_basic
